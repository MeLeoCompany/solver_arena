# Secrets
.env
backend/.env
.env.production

# Python
backend/venv/
**/__pycache__/
*.pyc

# Runtime data (SQLite DB, uploads, solver results/logs)
backend/data/
backend/logs/

# TLS certs (Let's Encrypt) — private key material, never commit
deploy/letsencrypt/
deploy/certbot-webroot/

# Vendored solver binaries (CPLEX/ALGLIB/QORE) — shipped separately, not via git
backend/engines/**/*.so
backend/engines/**/*.dll
backend/engines/**/*.h

# Test fixture MPS files — only used by pytest (tests/conftest.py::EXAMPLES_DIR),
# not by the running app or the Docker image; heavy, not worth it in git.
backend/examples/

# Frontend
frontend/node_modules/
frontend/dist/

# Tooling / editor
.pytest_cache/
.vscode/
.claude/
