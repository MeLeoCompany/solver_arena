# Copy this to .env (repo root) before running `docker compose up`.
# docker-compose.yml injects these into both the backend and nginx
# containers' environments.

SOLVER_SERVER_ADMIN_USERNAME=admin
SOLVER_SERVER_ADMIN_PASSWORD=change-me-please

# Flip to true once DOMAIN below is set (real HTTPS) — leave false for
# local testing on plain http://localhost, otherwise session cookies
# aren't marked Secure and login won't work over plain HTTP.
SOLVER_SERVER_SESSION_COOKIE_SECURE=false

# --- TLS ---
# Leave DOMAIN empty for local testing — nginx serves plain HTTP on :80
# and prints a warning on startup. Set it (a real domain pointing at this
# server's public IP) to have nginx automatically obtain and renew a
# Let's Encrypt certificate via certbot and serve HTTPS on :443 instead.
DOMAIN=
CERTBOT_EMAIL=
