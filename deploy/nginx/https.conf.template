# Рабочий конфиг после того, как сертификат для $DOMAIN уже получен.
server {
    listen 80;
    server_name ${DOMAIN};

    # Certbot продлевает сертификат через этот же webroot, пока nginx уже
    # отдаёт остальной трафик по HTTPS — challenge должен продолжать
    # работать и на 80-м порту, не только при первичной выдаче.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # MPS-файлы и особенно zip-архивы батчей легко превышают дефолтный
    # 1m — без этого загрузка большого файла падает с "413 Request Entity
    # Too Large" ещё на nginx, не доходя до бэкенда.
    client_max_body_size 500m;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback — React Router handles routing client-side.
    location / {
        try_files $uri /index.html;
    }

    # API prefixes — mirrors frontend/vite.config.ts's dev-time proxy list
    # and the top-level routers in backend/app/api/*.py.
    #
    # Several of these prefixes are also SPA page paths (/solve, /compare,
    # /batches/new, /batches/:id, ...) — a plain regex match here would
    # swallow full-page GETs for those paths too (e.g. hitting F5 on
    # /batches/new forwards to the backend, which parses "new" as a batch_id
    # and returns a JSON 404 instead of the page). Browser navigations send
    # `Accept: text/html...` first; our own frontend/src/api/client.ts calls
    # don't — so hand html-accepting requests back to the SPA fallback above
    # and only proxy actual API calls.
    location ~ ^/(auth|batches|compare|jobs|solve|solvers|system|users|qore-versions)(/|$) {
        if ($http_accept ~* "text/html") {
            rewrite ^ /index.html last;
        }

        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE endpoints (/jobs/*/logs, /batches/*/logs,
        # /system/status/stream) need buffering off, or live streams arrive
        # as one chunk at the end instead of in real time.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
