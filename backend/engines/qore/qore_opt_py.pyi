import collections.abc
from typing import ClassVar, overload

BOOLEAN: VariableType
CONTINUOUS: VariableType
EQ: ConstraintType
GREATER_EQ: ConstraintType
INCORRECT_DATA: OptimizationStatus
INFEASIBLE: OptimizationStatus
INTEGER: VariableType
INTERRUPTED: OptimizationStatus
LESS_EQ: ConstraintType
MAX: ObjSense
MIN: ObjSense
NODE_LIMIT_REACHED: OptimizationStatus
NOT_FOUND: OptimizationStatus
NOT_STARTED: OptimizationStatus
OPTIMAL: OptimizationStatus
RUNNING: OptimizationStatus
SEMICONTINUOUS: VariableType
SUB_OPTIMAL: OptimizationStatus
TIME_LIMIT_REACHED: OptimizationStatus
UNBOUNDED: OptimizationStatus
kQoreInf: float
kQoreNegInf: float

class ConstraintType:
    __members__: ClassVar[dict] = ...  # read-only
    EQ: ClassVar[ConstraintType] = ...
    GREATER_EQ: ClassVar[ConstraintType] = ...
    LESS_EQ: ClassVar[ConstraintType] = ...
    __entries: ClassVar[dict] = ...
    def __init__(self, value) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __index__(self) -> int: ...
    def __int__(self) -> int: ...
    def __ne__(self, other: object) -> bool: ...
    @property
    def name(self): ...
    @property
    def value(self) -> int: ...

class MatrixTriplet:
    column: int
    row: int
    value: float
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, row, col, value) -> None: ...
    def __eq__(self, arg0: MatrixTriplet) -> bool: ...
    def __getitem__(self, arg0) -> object: ...
    def __hash__(self) -> int: ...
    def __iter__(self) -> collections.abc.Iterator[int]: ...

class ObjSense:
    __members__: ClassVar[dict] = ...  # read-only
    MAX: ClassVar[ObjSense] = ...
    MIN: ClassVar[ObjSense] = ...
    __entries: ClassVar[dict] = ...
    def __init__(self, value) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __index__(self) -> int: ...
    def __int__(self) -> int: ...
    def __ne__(self, other: object) -> bool: ...
    @property
    def name(self): ...
    @property
    def value(self) -> int: ...

class OptimizationStatus:
    __members__: ClassVar[dict] = ...  # read-only
    INCORRECT_DATA: ClassVar[OptimizationStatus] = ...
    INFEASIBLE: ClassVar[OptimizationStatus] = ...
    INTERRUPTED: ClassVar[OptimizationStatus] = ...
    NODE_LIMIT_REACHED: ClassVar[OptimizationStatus] = ...
    NOT_FOUND: ClassVar[OptimizationStatus] = ...
    NOT_STARTED: ClassVar[OptimizationStatus] = ...
    OPTIMAL: ClassVar[OptimizationStatus] = ...
    RUNNING: ClassVar[OptimizationStatus] = ...
    SUB_OPTIMAL: ClassVar[OptimizationStatus] = ...
    TIME_LIMIT_REACHED: ClassVar[OptimizationStatus] = ...
    UNBOUNDED: ClassVar[OptimizationStatus] = ...
    __entries: ClassVar[dict] = ...
    def __init__(self, value) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __index__(self) -> int: ...
    def __int__(self) -> int: ...
    def __ne__(self, other: object) -> bool: ...
    @property
    def name(self): ...
    @property
    def value(self) -> int: ...

class QoreModel:
    def __init__(self) -> None: ...
    @overload
    def add_constraint(self, type: ConstraintType, rhs=..., name=...) -> int: ...
    @overload
    def add_constraint(self, var_indices, coeffs, type: ConstraintType, rhs=..., name=...) -> int: ...
    def add_indicator_constraint(self, indicator_var, constrained_var, name=...) -> int: ...
    def add_sos1_constraint(self, var_indices, type: ConstraintType, name=...) -> int: ...
    def add_variable(self, type: VariableType = ..., lower_bound=..., upper_bound=..., name=...) -> int: ...
    def clear(self) -> None: ...
    def fix_variable(self, variable_index, value) -> None: ...
    def get_constraint_coeff(self, constraint_index, variable_index) -> float: ...
    def get_constraint_rhs(self, constraint_index) -> float: ...
    def get_constraints_count(self) -> int: ...
    def get_objective_coeff(self, variable_index) -> float: ...
    def get_objective_offset(self) -> float: ...
    def get_quadratic_objective_coeff(self, i, j) -> float: ...
    def get_variable_bounds(self, variable_index) -> tuple[float, float]: ...
    def get_variables_count(self) -> int: ...
    def is_milp(self) -> bool: ...
    def is_qp(self) -> bool: ...
    def read_model_from_file(self, model_path: str) -> bool: ...
    def reserve_for_constraints(self, m) -> None: ...
    def reserve_for_variables(self, n) -> None: ...
    def set_constraint_coeff(self, constraint_index, variable_index, coeff) -> None: ...
    def set_constraint_rhs(self, constraint_index, rhs) -> None: ...
    def set_constraint_type(self, constraint_index, type: ConstraintType) -> None: ...
    def set_full_model(self, m, n, f, intcon, Aeq: collections.abc.Sequence[MatrixTriplet], beq, Aineq: collections.abc.Sequence[MatrixTriplet], bineq, lb, ub) -> None: ...
    def set_log_level(self, level_str: str) -> None: ...
    def set_objective(self, obj, sense: ObjSense = ...) -> None: ...
    def set_objective_coeff(self, variable_index, cost) -> None: ...
    def set_objective_offset(self, cost_offset) -> None: ...
    def set_quadratic_objective(self, hessian: collections.abc.Sequence[MatrixTriplet]) -> None: ...
    def set_quadratic_objective_coeff(self, i, j, value) -> None: ...
    def write_model_to_file(self, path: str, ext: str = ...) -> None: ...
    def __len__(self) -> int: ...
    @property
    def constraints_count(self) -> int: ...
    @property
    def variables_count(self) -> int: ...

class QoreOpt:
    def __init__(self) -> None: ...
    def clear(self) -> None: ...
    def get_solution(self) -> QoreSolution: ...
    def interrupt(self) -> None: ...
    def is_running(self) -> bool: ...
    def optimize(self) -> OptimizationStatus: ...
    def set_configuration(self, config: str) -> None: ...
    def set_model(self, model: QoreModel) -> None: ...
    def set_up_logger(self, log_file: str = ...) -> None: ...
    def write_solution_to_file(self, path: str) -> None: ...

class QoreSolution:
    def __init__(self) -> None: ...
    @property
    def best_bound(self) -> float: ...
    @property
    def gap(self) -> float: ...
    @property
    def is_lp(self) -> bool: ...
    @property
    def objective(self) -> float: ...
    @property
    def processed_nodes(self) -> int: ...
    @property
    def status(self) -> OptimizationStatus: ...
    @property
    def time(self) -> float: ...
    @property
    def total_simplex_iterations(self) -> int: ...
    @property
    def variables_values(self) -> list[float]: ...

